PORT=3000
HOST=127.0.0.1

# Supabase is the only application database.
# Required for the Supabase backend. Copy actual values from the Connect panel.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full"
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_SECRET
SUPABASE_STORAGE_BUCKET=school-documents
DB_POOL_MAX=1
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Generate once: node -p "require('crypto').randomBytes(32).toString('hex')"
# Preserve the same encryption key across deployments and restores.
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Use the actual HTTPS deployment URL on Vercel.
APP_URL=http://127.0.0.1:3000
# Set NODE_ENV=production and TRUST_PROXY_HOPS=1 on Vercel.
# NODE_ENV=production
# TRUST_PROXY_HOPS=1
# FEE_REMINDER_DAYS=7,14,30

# Super admins configure SMTP and payment credentials in Administration.
# Required for registration verification; also defaults for school email:
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=school@example.com
# PAYSTACK_SCHOOL_KEYS_JSON={"1":"sk_test_REPLACE"}
# PAYSTACK_LIVE_ENABLED=false

# Optional separate database for integration and browser tests (never production data).
# TEST_DATABASE_URL="postgresql://test_user:password@localhost:5432/smpis_tests"

# Production APP_URL: https://smpis.digital on Vercel and Railway.
